#!/bin/bash
# lcd-init - Initialize tmux LCD session for Zealot
# Two windows only: zealot display + escape shell
export TERM=linux

SESSION="lcd"

# Kill old session if exists
tmux kill-session -t "$SESSION" 2>/dev/null
sleep 0.5

# LCD hardware: 320x480 TFT with TerminusBold14 = 40 cols x 34 rows
LCD_COLS=40
LCD_ROWS=34
# Subtract 1 row for tmux status bar (physical bottom row on TFT)
TMUX_ROWS=$((LCD_ROWS - 1))

HOST_SHORT=$(hostname -s 2>/dev/null | cut -c1-8)
LAN_IP=$(hostname -I 2>/dev/null | awk '{print $1}')

tmux new-session -d -s "$SESSION" -x "$LCD_COLS" -y "$TMUX_ROWS" \
    "export LCD_COLS=$LCD_COLS LCD_ROWS=$LCD_ROWS TERM=linux; exec bash \"$HOME/.local/bin/zealot_display_loop.sh\""

tmux set-option -t "$SESSION" window-size smallest 2>/dev/null
tmux set-window-option -t "$SESSION" aggressive-resize on 2>/dev/null

# Mesh status bar — black row, high-contrast text (cyan/green on green was unreadable on TFT)
tmux set-option -t "$SESSION" status-style 'bg=black,fg=white' 2>/dev/null
tmux set-option -t "$SESSION" status-left '' 2>/dev/null
tmux set-option -t "$SESSION" status-left-length 0 2>/dev/null
tmux set-window-option -t "$SESSION" window-status-format '' 2>/dev/null
tmux set-window-option -t "$SESSION" window-status-current-format '' 2>/dev/null
tmux set-option -t "$SESSION" status-justify left 2>/dev/null
tmux set-option -t "$SESSION" status-right "#[fg=white]${LAN_IP} #[fg=yellow]${HOST_SHORT}" 2>/dev/null
tmux set-option -t "$SESSION" status-right-length 40 2>/dev/null
tmux set-option -t "$SESSION" message-style 'bg=black,fg=yellow,bold' 2>/dev/null
tmux set-option -t "$SESSION" pane-border-style 'fg=blue' 2>/dev/null
tmux set-option -t "$SESSION" pane-active-border-style 'fg=cyan' 2>/dev/null

# Short window names for manual tmux attach (not shown on bar)
tmux rename-window -t "${SESSION}:1" 'z'
tmux new-window -t "${SESSION}" -n '$'
tmux send-keys -t "${SESSION}:2" 'export TERM=linux' Enter
tmux select-window -t "${SESSION}:1"
# Re-apply after second window exists — otherwise default #I:#W wins
tmux set-window-option -t "$SESSION" window-status-format '' 2>/dev/null
tmux set-window-option -t "$SESSION" window-status-current-format '' 2>/dev/null

echo "LCD session initialized: ${LCD_COLS}x${LCD_ROWS} bar=${HOST_SHORT} ${LAN_IP}"